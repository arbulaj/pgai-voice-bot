# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin

# Public HTTPS URL that points to this FastAPI server, no trailing slash.
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://YOUR-PUBLIC-URL

# Safety: the app refuses to dial anything except this exact number.
TEST_NUMBER=+18054398008

# Optional server settings
HOST=0.0.0.0
PORT=8000

# Set to legacy only if your OpenAI Realtime account uses the older beta session schema.
REALTIME_SCHEMA=ga
